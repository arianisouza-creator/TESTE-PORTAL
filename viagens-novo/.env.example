# Copie para .env e ajuste os valores. O .env NAO deve ser versionado.

# E-mail liberado a entrar na gestao (protege /portal, /rest/v1 e as rotas de
# cotacao/compra). So quem digitar EXATAMENTE esse e-mail no login consegue
# entrar - sem essa variavel, o login fica bloqueado (ninguem consegue entrar).
# Atencao: nao ha senha nem confirmacao por e-mail, entao qualquer pessoa que
# souber esse endereco tambem consegue entrar digitando-o - o controle e por
# conveniencia (uso local, na maquina da Ariani), nao um login forte.
ADMIN_EMAIL=ariani.souza@mse.com.br

# Chave de sessao do Flask - qualquer texto aleatorio longo.
FLASK_SECRET_KEY=troque-por-um-texto-aleatorio-longo

# Banco de dados local (SQLite, nao precisa instalar nada).
# Deixe vazio para usar o arquivo portal_mse.db nesta mesma pasta.
# Quando for para producao, aponte para o MySQL real, por exemplo:
# DATABASE_URL=mysql+pymysql://usuario:senha@dbsubdominios.portalmse.com.br:3306/controle_internet
DATABASE_URL=

# API local de cotacoes (cotacoes_api.py, rodando na porta 8001).
COTACOES_API_BASE_URL=http://127.0.0.1:8001
COTACOES_TIMEOUT_SECONDS=180

# API do sistema atual de passagens (hub_mse/api_passagens) - traz pra dentro
# deste projeto as viagens que ja foram registradas la (compradas). O token
# e uma chave de acesso de verdade: preencha isso SO no seu .env local (nunca
# neste .env.example, nunca em nenhum arquivo que eu te mande pelo chat).
PASSAGENS_API_BASE_URL=https://portalmse.com.br/microservices/hub_mse/api_passagens
PASSAGENS_API_TOKEN=

# API de Pedidos (portalmse.com.br) - consulta o status de um pedido (Em
# Aberto, Finalizado etc) pelo numero, usada na aba Aereo e no fechamento de
# fatura. E a chave de 64 caracteres que a TI te entregou (guia "API de
# Pedidos - Guia do Usuario"), so-leitura. Preencha isso SO no seu .env
# local (nunca neste .env.example, nunca em nenhum arquivo que eu te mande
# pelo chat).
PEDIDOS_API_BASE_URL=https://portalmse.com.br/microservices/pedidos_usuarios_api
PEDIDOS_API_TOKEN=

# Login LATAM/Azul do robo de cotacao - alternativa a aba "Login LATAM/Azul"
# do painel (que salva em cotacoes_data.json). Se preencher aqui, tem
# prioridade sobre o que estiver salvo pela tela. Preencha isso SO no seu
# .env local (nunca neste .env.example, nunca em nenhum arquivo que eu te
# mande pelo chat) - e reinicie o terminal do robo de cotacao (uvicorn
# cotacoes_api) depois de mudar.
COTACOES_LATAM_USUARIO=
COTACOES_LATAM_SENHA=
COTACOES_AZUL_USUARIO=
COTACOES_AZUL_SENHA=

# Liga a automacao de verdade (abre o navegador e cota na LATAM/Azul de
# verdade). Sem isso, o robo roda em "modo sandbox" - responde rapido, sem
# abrir nada, e sem achar nenhuma passagem de verdade (e isso que estava
# acontecendo quando o terminal do robo era iniciado direto pelo comando do
# uvicorn, sem passar pelo botao verde "API + Portal" do VS Code, que e onde
# essas variaveis estavam configuradas ate agora). Com essas linhas aqui no
# .env, funciona igual não importa como voce inicie o terminal do robo.
COTACOES_LATAM_MODE=browser
COTACOES_AZUL_MODE=browser
COTACOES_LATAM_HEADLESS=false
COTACOES_AZUL_HEADLESS=false
COTACOES_LATAM_PROFILE_DIR=.playwright-latam-profile
COTACOES_AZUL_PROFILE_DIR=.playwright-azul-empresas-profile

# Servidor
PORT=8000
FLASK_DEBUG=0
